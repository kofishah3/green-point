# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/prisma_app/generated/prisma

# Model API - Large files (datasets, models, imagery)
model_api/Dataset/*.tiff
model_api/Dataset/*.zip
model_api/Dataset/*.kmz
model_api/Dataset/*.png
model_api/outputs/models/*.pkl
model_api/__pycache__/
model_api/src/__pycache__/

# Keep only essential Model API files
# - Source code (.py files)
# - CSV outputs (small)
# - Documentation
# - Configuration